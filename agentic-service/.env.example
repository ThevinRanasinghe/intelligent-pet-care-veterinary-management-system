# === PetCare Agentic Service — environment template ===
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# Gemini API key for the LLM. REQUIRED — the service fails clearly without it.
GEMINI_API_KEY=

# Gemini model identifier (optional; defaults to gemini-3.5-flash).
GEMINI_MODEL=gemini-3.5-flash

# Base URL of the PetCare ASP.NET Core API, including /api.
API_BASE_URL=http://localhost:5019/api

# Shared secret that the ASP.NET Core API sends in the X-Internal-Key header.
# Must match the API's AgenticService:InternalKey configuration.
# REQUIRED — all agent endpoints return 503 while unset.
AGENTIC_INTERNAL_KEY=

# Timeout (seconds) for each Agentic Service -> backend HTTP call.
BACKEND_TIMEOUT_SECONDS=10

# Port for `python main.py` (default 8000).
PORT=8000
